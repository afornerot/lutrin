# Base configuration for Lutrin project
# This file is committed to git and contains default values.
# Override with .env.local for your specific environment.

# Groq API token for AI features (optional)
GROQ_TOKEN=changeme

# Mail configuration (default: sendmail)
MAILER_DSN=sendmail://default

# Frontend URL for links in emails (default: https://localhost:8000)
FRONT_URL=https://localhost:8000

# Coqui TTS URL (default: http://coqui:5002)
COQUI_TTS_URL=http://coqui:5002

# Coqui TTS model to use
# Available: tts_models/multilingual/multi-dataset/xtts_v2, tts_models/fr/mai/tacotron2-DDC, tts_models/fr/css10/vits
COQUI_MODEL=tts_models/multilingual/multi-dataset/xtts_v2

# Flask port (default: 5000)
FLASK_PORT=5000

# Upload folder (default: /data)
UPLOAD_FOLDER=/data

# Database path (default: /data/database.db)
DATABASE_PATH=/data/database.db

# Client port (default: 8000)
CLIENT_PORT=8000

# Client API connection
API_PORT=5000
API_HOST=api

# Piper TTS model relative path (relative to lutrin_api/)
PIPER_MODEL=models/fr_FR-siwis-medium.onnx